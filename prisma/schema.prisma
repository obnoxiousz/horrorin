// Horrorin — Prisma schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===================== AUTH / USERS =====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String?
  name          String?
  image         String?
  username      String?   @unique
  bio           String?
  role          String    @default("USER") // USER | ADMIN
  banned        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  stories       Story[]
  comments      Comment[]
  likes         Like[]
  bookmarks     Bookmark[]
  drafts        Draft[]
  notifications Notification[]
  reports       Report[]

  followersRel  Follow[]    @relation("Following")
  followingRel  Follow[]    @relation("Follower")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===================== PROFILE =====================

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarUrl   String?
  coverUrl    String?
  bio         String?
  location    String?
  websiteUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===================== CATEGORIES =====================

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())

  stories     Story[]
}

// ===================== TEMPLATES =====================

model StoryTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  icon        String?
  // JSON string describing the block blueprint, e.g.:
  // [{ "type": "image" }, { "type": "text" }, { "type": "image" }, { "type": "text" }]
  structure   String
  previewUrl  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stories     Story[]
}

// ===================== STORIES =====================

model Story {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  excerpt      String?
  thumbnailUrl String?
  readingTime  Int      @default(1)
  status       String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  viewCount    Int      @default(0)
  likeCount    Int      @default(0)
  commentCount Int      @default(0)
  bookmarkCount Int     @default(0)

  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])

  templateId   String?
  template     StoryTemplate? @relation(fields: [templateId], references: [id])

  tags         Tag[]
  blocks       StoryBlock[]
  comments     Comment[]
  likes        Like[]
  bookmarks    Bookmark[]
  reports      Report[]

  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([authorId])
  @@index([categoryId])
  @@index([status])
  @@index([publishedAt])
  // Composite indexes sized to the public list sort orders:
  // latest = (status, publishedAt desc); trending = (status, likeCount; viewCount);
  // recommended = (status, bookmarkCount; likeCount).
  @@index([status, publishedAt])
  @@index([status, likeCount])
  @@index([status, viewCount])
  @@index([status, bookmarkCount])
}

model StoryBlock {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  // text | image | quote | gallery | timeline | chat | news | cctv | police | investigation | diary | conversation
  type      String
  // JSON-encoded payload: { text, imageUrl, caption, align, fontSize, color, items[], ... }
  data      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storyId])
}

model Tag {
  id      String  @id @default(cuid())
  name    String  @unique
  stories Story[]
}

// ===================== ENGAGEMENT =====================

model Comment {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  parentId  String?  // for threaded replies
  likesCount Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storyId])
  @@index([authorId])
}

model Like {
  id        String   @id @default(cuid())
  storyId   String?
  story     Story?   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  commentId String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, storyId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, storyId])
}

// ===================== SOCIAL =====================

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower",  fields: [followerId],  references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

// ===================== NOTIFICATIONS =====================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // LIKE | COMMENT | FOLLOW | STORY_PUBLISHED | SYSTEM
  actorId   String?
  storyId   String?
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  // unreadCount filters (userId, read); the inbox orders (userId, createdAt).
  @@index([userId, read])
  @@index([userId, createdAt])
}

// ===================== DRAFTS =====================

model Draft {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId   String?  // optional link to a story being edited
  title     String?
  payload   String   // JSON-encoded full editor state
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([userId])
}

// ===================== ADMIN / REPORTS =====================

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  reporter    User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  storyId     String?
  story       Story?   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  reason      String
  detail      String?
  status      String   @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
